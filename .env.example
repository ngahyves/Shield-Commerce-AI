# ═══════════════════════════════════════════════════════════════════
# ShieldCommerce AI — Secrets template
# ═══════════════════════════════════════════════════════════════════

# ─── Environment
ENV=dev

# ─── Databricks
DATABRICKS_HOST=https://xxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxx

# LLM key
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GEMINI_API_KEY=AQ.xxxxxxxxxxx


#Langchain
LANGCHAIN_API_KEY=lsv2_xxxxxxxxx
LANGCHAIN_PROJECT=shield_com_ai
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ─── MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_URI=http://localhost:5000

# ─── Redis (local — shieldcommerce-redis on 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6380/0

# ─── Qdrant (local — shieldcommerce-qdrant on 6335)
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_GRPC_PORT=6336

# ─── Monitoring 
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001